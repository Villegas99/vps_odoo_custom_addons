<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        
        <!-- Eliminar etapas existentes por defecto si es necesario -->
        <!-- Nota: Esto es opcional, puedes comentarlo si quieres mantener las etapas por defecto -->
        
        <!-- Crear las etapas B2B personalizadas -->
        <record id="b2b_stage_generate_interest" model="crm.stage">
            <field name="name">Generar Interés</field>
            <field name="sequence">1</field>
            <field name="close_rate">0</field>
            <field name="fold">False</field>
            <field name="is_won">False</field>
        </record>

        <record id="b2b_stage_interested" model="crm.stage">
            <field name="name">Interesado</field>
            <field name="sequence">2</field>
            <field name="close_rate">10</field>
            <field name="fold">False</field>
            <field name="is_won">False</field>
        </record>

        <record id="b2b_stage_consultative_meeting" model="crm.stage">
            <field name="name">Reunión consultiva</field>
            <field name="sequence">3</field>
            <field name="close_rate">20</field>
            <field name="fold">False</field>
            <field name="is_won">False</field>
        </record>

        <record id="b2b_stage_prequalified_opportunity" model="crm.stage">
            <field name="name">Oportunidad precalificada</field>
            <field name="sequence">4</field>
            <field name="close_rate">30</field>
            <field name="fold">False</field>
            <field name="is_won">False</field>
        </record>

        <record id="b2b_stage_qualified_opportunity" model="crm.stage">
            <field name="name">Oportunidad calificada</field>
            <field name="sequence">5</field>
            <field name="close_rate">60</field>
            <field name="fold">False</field>
            <field name="is_won">False</field>
        </record>

        <record id="b2b_stage_strengthening" model="crm.stage">
            <field name="name">Fortalecimiento</field>
            <field name="sequence">6</field>
            <field name="close_rate">80</field>
            <field name="fold">False</field>
            <field name="is_won">False</field>
        </record>

        <record id="b2b_stage_closing_process" model="crm.stage">
            <field name="name">Proceso de cierre</field>
            <field name="sequence">7</field>
            <field name="close_rate">90</field>
            <field name="fold">False</field>
            <field name="is_won">False</field>
        </record>

        <record id="b2b_stage_closed" model="crm.stage">
            <field name="name">Cerrado</field>
            <field name="sequence">8</field>
            <field name="close_rate">100</field>
            <field name="fold">True</field>
            <field name="is_won">True</field>
        </record>

        <!-- Crear un equipo de ventas B2B -->
        <record id="b2b_sales_team" model="crm.team">
            <field name="name">Equipo B2B</field>
            <field name="sequence">1</field>
            <field name="active">True</field>
        </record>

    </data>
</odoo>